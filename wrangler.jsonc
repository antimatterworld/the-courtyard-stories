{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courtyard-stories",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/real/*.mp4"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "courtyard-stories-media"
    }
  ],
  "vars": {
    "ENQUIRY_COLLECTOR_URL": "https://courtyardstories-internal.dev/hooks/enquiry"
  }
}
